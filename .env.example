# Локальный запуск всего проекта одной группой: cp .env.example .env
# Все значения имеют разумные умолчания — файл можно скопировать как есть.

# --- имя проекта (группа в Docker) -----------------------------------------
# Docker приводит имя группы к нижнему регистру: в Docker Desktop будет
# отображаться `smartupcms`. Имена контейнеров сохраняют регистр:
# smartupcms-server, smartupcms-postgres, smartupcms-web и т. д.
PROJECT_NAME=smartupcms

# --- версия образов --------------------------------------------------------
APP_VERSION=dev

# --- организация -----------------------------------------------------------
ORGANIZATION_CODE=local
ORGANIZATION_NAME=Local Organization
RESOURCE_PROFILE=S
SPRING_PROFILE=dev

DB_NAME=smartupcms
DB_USER=smartupcms
DB_PASSWORD=smartupcms_local_dev
# Вторая база (pg-dwh, ADR-0001). Создаётся образом postgres при первой инициализации тома, владелец — DB_USER.
# Том уже создан — создайте базу один раз вручную: docker compose exec postgres psql -U postgres -c "create database smartupcms_dwh owner smartupcms"
WAREHOUSE_DB_NAME=smartupcms_dwh
WAREHOUSE_CONNECT_TIMEOUT=5s
# Предел одного запроса к pg-dwh и простоя в транзакции; задания обслуживания (очистка, сверка raw) — свой.
WAREHOUSE_STATEMENT_TIMEOUT=60s
WAREHOUSE_MAINTENANCE_STATEMENT_TIMEOUT=30m
# Предел одной потоковой записи загрузки в raw (применение файла UPL: COPY длится, пока разбирается файл).
WAREHOUSE_RAW_WRITE_TIMEOUT=30m
# Предел одного запроса к основной базе и простоя в транзакции (длительности PostgreSQL: 60s, 5min; 0 — выкл.).
SMC_DB_STATEMENT_TIMEOUT=60s
SMC_DB_IDLE_IN_TRANSACTION_TIMEOUT=60s
# Срок хранения журналов: время ночного прохода, строк за пакет и пакетов за проход на журнал,
# дни жизни строки каждого журнала (0 — хранить всё).
# docs/ops/operations-runbook.md, раздел «Retention of journal tables».
SMC_RETENTION_CRON=0 30 3 * * *
SMC_RETENTION_BATCH_SIZE=5000
SMC_RETENTION_MAX_BATCHES=200
SMC_RETENTION_SECURITY_EVENTS_DAYS=365
SMC_RETENTION_LOGIN_ATTEMPTS_DAYS=30
SMC_RETENTION_OTP_CODES_DAYS=7
SMC_RETENTION_PASSWORD_RESET_CODES_DAYS=7
SMC_RETENTION_CLOSED_SESSIONS_DAYS=90
SMC_RETENTION_WEBHOOK_LOGS_DAYS=90
SMC_RETENTION_WEBHOOK_OUTBOX_DAYS=30
SMC_RETENTION_INBOX_DAYS=180
SMC_RETENTION_NOTIFICATION_OUTBOX_DAYS=30
SMC_RETENTION_JOB_RUNS_DAYS=90
SMC_RETENTION_FAILED_JOBS_DAYS=90
SMC_RETENTION_SEARCH_JOBS_DAYS=90
# Очередь заданий: попытки упавшего задания, пауза между ними (удваивается до потолка) и аренда задания узлом.
SMC_JOBS_MAX_ATTEMPTS=5
SMC_JOBS_RETRY_BACKOFF=30s
SMC_JOBS_RETRY_BACKOFF_MAX=1h
SMC_JOBS_LEASE=5m

# --- хранилище файлов ----------------------------------------------------
# local_disk — без внешних сервисов. s3 — AWS S3, Cloudflare R2, MinIO, Garage.
SMC_PROVIDER_STORAGE=local_disk
SMC_STORAGE_LOCAL_PATH=/var/lib/smartupcms/storage

# Обязательны только при SMC_PROVIDER_STORAGE=s3. Для R2 region=auto.
# Пример R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
SMC_S3_ENDPOINT=
SMC_S3_REGION=auto
SMC_S3_ACCESS_KEY=
SMC_S3_SECRET_KEY=
SMC_S3_BUCKET=
SMC_S3_PATH_STYLE=true
SMC_S3_CONNECT_TIMEOUT=5s
SMC_S3_READ_TIMEOUT=30s
SMC_SYSTEM_HEALTH_TIMEOUT=2s
# Установите утверждённый допустимый возраст backup, например 26h. Значение 0s
# оставляет политику ненастроенной и не позволяет статусу стать зелёным.
SMC_BACKUP_MAX_AGE=0s

# --- проверка загружаемых файлов -----------------------------------------
# В production включите ClamAV и required=true. При required=true сервер
# не стартует без активного scanner provider; ошибка/INFECTED fail-closed.
SMC_FILE_SCANNER_REQUIRED=false
SMC_FILE_SCANNER_CLAMAV_ENABLED=false
SMC_FILE_SCANNER_CLAMAV_HOST=clamav
SMC_FILE_SCANNER_CLAMAV_PORT=3310
SMC_FILE_SCANNER_CLAMAV_CONNECT_TIMEOUT=3s
SMC_FILE_SCANNER_CLAMAV_READ_TIMEOUT=60s

# Публичные словари локализации используют отдельный bucket, чтобы общий
# корпоративный NAT не блокировал загрузку языка и форму входа.
SMC_RATE_LIMIT_PUBLIC_READ_PER_MINUTE=600

# --- исходящие вебхуки ---------------------------------------------------
# Fail-closed по умолчанию. Для включения задайте точные DNS host без схемы,
# wildcard и пути, например: hooks.example.com,events.partner.example.
SMC_WEBHOOKS_ENABLED=false
SMC_WEBHOOKS_ALLOWED_HOSTS=
# Разрешает loopback/private/link-local только для осознанной client-owned сети.
# Для Smartup-managed и internet-facing установок должно оставаться false.
SMC_WEBHOOKS_ALLOW_PRIVATE_ADDRESSES=false
SMC_WEBHOOKS_CONNECT_TIMEOUT=3s
SMC_WEBHOOKS_READ_TIMEOUT=10s

# Первый администратор создаётся один раз при первом старте.
# Смена пароля при первом входе обязательна.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@dev.local
ADMIN_PASSWORD=DevOnly-ChangeMe-1

# --- порты на хосте --------------------------------------------------------
WEB_PORT=4200        # интерфейс: http://localhost:4200
E2E_WEB_PORT=4201    # второй адрес интерфейса, на нём идут e2e-тесты
DB_PORT=5432         # PostgreSQL (для локальной отладки)
TYPESENSE_PORT=8108  # Typesense поисковый сервер: http://localhost:8108
TYPESENSE_API_KEY=smartupcms_typesense_local_dev

# Backup запускается отдельно: docker compose --profile backup up -d backup
# До запуска создайте оба файла и выполните: docker compose run --rm backup-bootstrap
DB_PASSWORD_FILE=deploy/compose/.secrets/database-password
BACKUP_DB_USER=smartupcms_backup
BACKUP_DB_PASSWORD_FILE=deploy/compose/.secrets/backup-database-password
BACKUP_AGE_RECIPIENT=
BACKUP_STORAGE_MODE=local
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14


# --- каналы доставки (FR-NOTIF-3/4/5) --------------------------------------
# Пока эти параметры пусты, письма, SMS и сообщения мессенджера НИКУДА не уходят:
# активны заглушки, которые пишут текст в журнал приложения. В этом состоянии
# не работают восстановление пароля и вход по одноразовому коду. Экземпляр
# предупреждает об этом в журнале при старте.
#
# Чтобы канал заработал, нужны ДВА шага: адрес шлюза и выбор провайдера.
#
# Публичный адрес веб-приложения: из него строится ссылка сброса пароля
# (никогда не из заголовка Host запроса). Пусто — ссылка не отправляется.
SMC_PUBLIC_URL=http://localhost:4200

# Почта: SMTP_HOST + SMC_PROVIDER_MAIL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMC_MAIL_FROM=no-reply@localhost
SMC_MAIL_FROM_NAME=SmartupCMS
SMC_PROVIDER_MAIL=console_mail

# Мессенджер: TELEGRAM_BOT_TOKEN + SMC_PROVIDER_MESSENGER=telegram
# Токен выдаёт @BotFather. Это секрет — в репозиторий не коммитить.
TELEGRAM_BOT_TOKEN=
SMC_PROVIDER_MESSENGER=console_messenger

# SMS: боевого шлюза ещё нет (долг по договору с оператором), остаётся заглушка.
SMC_PROVIDER_SMS=console_sms

# Файл журнала сервера: архивируется в .gz раз в неделю или при 100 МБ.
# Пусто — только консоль. В production по умолчанию /var/lib/smartupcms/logs/server.log.
SMC_LOG_FILE=
SMC_LOG_MAX_FILE_SIZE=100MB
SMC_LOG_MAX_HISTORY=12
SMC_LOG_TOTAL_SIZE_CAP=2GB

# Архив журнала аудита: закрытые дни раз в неделю или при 100 МБ уходят в
# файл .jsonl.gz, файл перечитывается и сверяется. Файлы хранятся 90 дней.
# Хранилище: local (каталог на сервере) или s3 (свой бакет, настройки ниже).
# DELETE_AFTER_ARCHIVE=true удаляет из базы только дни с проверенным архивом.
SMC_AUDIT_ARCHIVE_ENABLED=true
SMC_AUDIT_ARCHIVE_TARGET=local
SMC_AUDIT_ARCHIVE_LOCAL_PATH=/var/lib/smartupcms/audit-archive
SMC_AUDIT_ARCHIVE_INTERVAL=7d
SMC_AUDIT_ARCHIVE_SIZE_THRESHOLD=100MB
SMC_AUDIT_ARCHIVE_RETENTION=90d
SMC_AUDIT_ARCHIVE_DELETE_AFTER_ARCHIVE=false
SMC_AUDIT_ARCHIVE_S3_ENDPOINT=
SMC_AUDIT_ARCHIVE_S3_REGION=auto
SMC_AUDIT_ARCHIVE_S3_ACCESS_KEY=
SMC_AUDIT_ARCHIVE_S3_SECRET_KEY=
SMC_AUDIT_ARCHIVE_S3_BUCKET=
SMC_AUDIT_ARCHIVE_S3_PREFIX=audit/

# Отказ старта, пока пользователи с 2FA зависят от заглушки канала: их коды
# входа ушли бы в журнал. Локальный профиль dev выключает проверку сам.
SMC_DELIVERY_ENFORCE=true
