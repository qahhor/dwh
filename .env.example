# Локальный запуск всего проекта одной группой: cp .env.example .env
# Все значения имеют разумные умолчания — файл можно скопировать как есть.

# --- имя проекта (группа в Docker) -----------------------------------------
# Docker приводит имя группы к нижнему регистру: в Docker Desktop будет
# отображаться `smartupcms`. Имена контейнеров сохраняют регистр:
# SmartupCMS-app, SmartupCMS-db, SmartupCMS-web и т. д.
PROJECT_NAME=SmartupCMS

# --- версия образов --------------------------------------------------------
APP_VERSION=dev

# --- экземпляр клиента -----------------------------------------------------
CLIENT_CODE=dev-local
CLIENT_NAME=Local Development
RESOURCE_PROFILE=S
SPRING_PROFILE=dev

DB_NAME=dwh_instance
DB_USER=dwh
DB_PASSWORD=dwh_local_dev

# Первый администратор создаётся один раз при первом старте.
# Смена пароля при первом входе обязательна.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@dev.local
ADMIN_PASSWORD=DevOnly-ChangeMe-1

# --- control plane ---------------------------------------------------------
CP_DB_NAME=dwh_control_plane
CP_DB_USER=dwh_cp
CP_DB_PASSWORD=dwh_cp_local_dev

# Первый сотрудник control panel (вход в панель управления флотом)
CP_ADMIN_LOGIN=cpadmin
CP_ADMIN_EMAIL=cpadmin@dev.local
CP_ADMIN_PASSWORD=CpDevOnly-ChangeMe-1

# --- порты на хосте --------------------------------------------------------
WEB_PORT=4200        # интерфейс: http://localhost:4200
APP_PORT=8080        # API экземпляра
APP_MGMT_PORT=9190   # actuator экземпляра (9090 часто занят другими контейнерами)
CP_WEB_PORT=4300     # панель управления: http://localhost:4300
CP_PORT=8082         # API control plane
CP_MGMT_PORT=9191    # actuator control plane
DB_PORT=5432         # PostgreSQL экземпляра (для отладки)
TYPESENSE_PORT=8108  # Typesense поисковый сервер: http://localhost:8108
TYPESENSE_API_KEY=dwh_typesense_local_dev_key


# --- связь экземпляра с control plane (FR-INST-3) -------------------------
# Токен выдаётся один раз при регистрации экземпляра в панели (localhost:4300,
# вкладка «Клиенты»). Пока пусто — экземпляр в панели не появляется.
DWH_CP_URL=http://control-plane:8081
DWH_CP_HEARTBEAT_TOKEN=
DWH_CP_HEARTBEAT_INTERVAL=1m


# --- каналы доставки (FR-NOTIF-3/4/5) --------------------------------------
# Пока эти параметры пусты, письма, SMS и сообщения мессенджера НИКУДА не уходят:
# активны заглушки, которые пишут текст в журнал приложения. В этом состоянии
# не работают восстановление пароля и вход по одноразовому коду. Экземпляр
# предупреждает об этом в журнале при старте.
#
# Чтобы канал заработал, нужны ДВА шага: адрес шлюза и выбор провайдера.
#
# Почта: SMTP_HOST + DWH_PROVIDER_MAIL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
DWH_MAIL_FROM=no-reply@localhost
DWH_MAIL_FROM_NAME=DWH Platform
DWH_PROVIDER_MAIL=console_mail

# Мессенджер: TELEGRAM_BOT_TOKEN + DWH_PROVIDER_MESSENGER=telegram
# Токен выдаёт @BotFather. Это секрет — в репозиторий не коммитить.
TELEGRAM_BOT_TOKEN=
DWH_PROVIDER_MESSENGER=console_messenger

# SMS: боевого шлюза ещё нет (долг по договору с оператором), остаётся заглушка.
DWH_PROVIDER_SMS=console_sms
