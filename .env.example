# Локальный запуск всего проекта одной группой: cp .env.example .env
# Все значения имеют разумные умолчания — файл можно скопировать как есть.

# --- имя проекта (группа в Docker) -----------------------------------------
# Docker приводит имя группы к нижнему регистру: в Docker Desktop будет
# отображаться `smartupcms`. Имена контейнеров сохраняют регистр:
# SmartupCMS-app, SmartupCMS-db, SmartupCMS-web и т. д.
PROJECT_NAME=SmartupCMS

# --- версия образов --------------------------------------------------------
APP_VERSION=dev

# --- экземпляр клиента -----------------------------------------------------
CLIENT_CODE=dev-local
CLIENT_NAME=Local Development
RESOURCE_PROFILE=S
SPRING_PROFILE=dev

DB_NAME=dwh_instance
DB_USER=dwh
DB_PASSWORD=dwh_local_dev

# Первый администратор создаётся один раз при первом старте.
# Смена пароля при первом входе обязательна.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@dev.local
ADMIN_PASSWORD=DevOnly-ChangeMe-1

# --- control plane ---------------------------------------------------------
CP_DB_NAME=dwh_control_plane
CP_DB_USER=dwh_cp
CP_DB_PASSWORD=dwh_cp_local_dev

# Первый сотрудник control panel (вход в панель управления флотом)
CP_ADMIN_LOGIN=cpadmin
CP_ADMIN_EMAIL=cpadmin@dev.local
CP_ADMIN_PASSWORD=CpDevOnly-ChangeMe-1

# --- порты на хосте --------------------------------------------------------
WEB_PORT=4200        # интерфейс: http://localhost:4200
APP_PORT=8080        # API экземпляра
APP_MGMT_PORT=9190   # actuator экземпляра (9090 часто занят другими контейнерами)
CP_PORT=8082         # API control plane
CP_MGMT_PORT=9191    # actuator control plane
DB_PORT=5432         # PostgreSQL экземпляра (для отладки)
