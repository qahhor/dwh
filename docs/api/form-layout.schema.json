{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartupCMS form layout prototype v1",
  "description": "Presentation only. Server additionally checks UTF-8 size, duplicate keys, depth, permissions and exact current visible field coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "kind",
    "entityCode",
    "sections"
  ],
  "properties": {
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "form-layout"
    },
    "entityCode": {
      "const": "example.products"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "uz",
        "en"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "uz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    }
  }
}
