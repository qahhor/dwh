# ==============================================================================
# Smartup DWH / CMS Production Environment Template (.env.production)
# ==============================================================================
PROJECT_NAME=SmartupCMS
APP_VERSION=1.0.0
IMAGE_REGISTRY=smartupcms
POSTGRES_IMAGE=smartupcms/postgres:18-alpine-hardened

HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=dwh_instance
DB_USER=dwh_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS_LONG!

CLIENT_CODE=enterprise-prod
CLIENT_NAME=Smartup Enterprise Production
RESOURCE_PROFILE=M
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@enterprise.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_16_CHARS!

TYPESENSE_API_KEY=CHANGE_ME_STRONG_TYPESENSE_API_KEY_32_CHARS!

DWH_CP_URL=http://control-plane:8081
DWH_CP_HEARTBEAT_TOKEN=CHANGE_ME_GENERATED_INSTANCE_HEARTBEAT_TOKEN

CP_DB_NAME=dwh_control_plane
CP_DB_USER=dwh_cp_user
CP_DB_PASSWORD=CHANGE_ME_STRONG_CP_DB_PASSWORD_32_CHARS!

CP_ADMIN_LOGIN=cpadmin
CP_ADMIN_PASSWORD=CHANGE_ME_STRONG_CP_ADMIN_PASSWORD_16_CHARS!
