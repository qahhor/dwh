[
  {
    "checksum": "3feca12a9b17c598affc92c452ab8c6ed4c5b294ea53c2665f133f40b0ecf67b",
    "declaration": {
      "formatVersion": 5,
      "kind": "simple-form",
      "module": {
        "code": "studio",
        "title": {
          "ru": "Созданные формы",
          "uz": "Yaratilgan shakllar",
          "en": "Custom forms"
        }
      },
      "entity": {
        "name": "golden_v5_orders",
        "title": {
          "ru": "Заказ (шапка)",
          "uz": "Buyurtma (sarlavha)",
          "en": "Order (header)"
        },
        "menu": {
          "icon": "receipt_long",
          "section": "workspace",
          "order": 30
        },
        "scope": "all"
      },
      "fields": [
        {
          "id": "qty",
          "type": "number",
          "labels": {
            "ru": "Количество",
            "uz": "Miqdori",
            "en": "Quantity"
          },
          "required": true,
          "listed": true,
          "scale": 0
        },
        {
          "id": "price",
          "type": "number",
          "labels": {
            "ru": "Цена",
            "uz": "Narxi",
            "en": "Price"
          },
          "required": true,
          "listed": true,
          "scale": 2
        },
        {
          "id": "discount",
          "type": "number",
          "labels": {
            "ru": "Скидка, %",
            "uz": "Chegirma, %",
            "en": "Discount, %"
          },
          "required": false,
          "listed": true,
          "scale": 2
        },
        {
          "id": "total",
          "type": "number",
          "labels": {
            "ru": "Сумма",
            "uz": "Summa",
            "en": "Total"
          },
          "required": false,
          "listed": true,
          "scale": 2,
          "formula": "round(qty * price * (1 - coalesce(discount, 0) / 100), 2)"
        },
        {
          "id": "orderdate",
          "type": "date",
          "labels": {
            "ru": "Дата",
            "uz": "Sana",
            "en": "Date"
          },
          "required": true,
          "listed": true,
          "defaultFormula": "today()"
        },
        {
          "id": "reason",
          "type": "text",
          "labels": {
            "ru": "Причина скидки",
            "uz": "Chegirma sababi",
            "en": "Discount reason"
          },
          "required": false,
          "listed": false,
          "maxLength": 200,
          "visibleIf": "discount > 10",
          "requiredIf": "discount > 10"
        },
        {
          "id": "status",
          "type": "select",
          "labels": {
            "ru": "Статус",
            "uz": "Holati",
            "en": "Status"
          },
          "required": true,
          "listed": true,
          "options": [
            {
              "code": "new",
              "labels": {
                "ru": "Новый",
                "uz": "Yangi",
                "en": "New"
              }
            },
            {
              "code": "big",
              "labels": {
                "ru": "Крупный",
                "uz": "Yirik",
                "en": "Large"
              }
            }
          ],
          "defaultFormula": "if(qty >= 100, \"big\", \"new\")"
        },
        {
          "id": "note",
          "type": "textarea",
          "labels": {
            "ru": "Примечание",
            "uz": "Izoh",
            "en": "Note"
          },
          "required": false,
          "listed": false,
          "maxLength": 1000,
          "readonlyIf": "status = \"big\""
        },
        {
          "id": "legacy",
          "type": "text",
          "labels": {
            "ru": "Старое поле",
            "uz": "Eski maydon",
            "en": "Old field"
          },
          "required": false,
          "listed": false,
          "maxLength": 50,
          "hidden": true,
          "formula": "unknown + 1"
        }
      ],
      "layout": {
        "sections": [
          {
            "key": "main",
            "labels": {
              "ru": "Основное",
              "uz": "Asosiy",
              "en": "Main"
            },
            "fields": [
              "qty",
              "price",
              "discount",
              "total",
              "orderdate",
              "status"
            ]
          },
          {
            "key": "more",
            "labels": {
              "ru": "Дополнительно",
              "uz": "Qo'shimcha",
              "en": "More"
            },
            "fields": [
              "reason",
              "note"
            ]
          }
        ]
      },
      "rules": [
        {
          "key": "maxdiscount",
          "formula": "coalesce(discount, 0) <= 30",
          "message": {
            "ru": "Скидка не больше 30%",
            "uz": "Chegirma 30% dan oshmaydi",
            "en": "The discount is at most 30%"
          },
          "field": "discount"
        },
        {
          "key": "positive",
          "formula": "qty > 0 and price >= 0",
          "message": {
            "ru": "Количество и цена должны быть положительными",
            "uz": "Miqdor va narx musbat bo'lishi kerak",
            "en": "The quantity and the price must be positive"
          }
        }
      ]
    }
  },
