<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartup24.cms</groupId>
        <artifactId>smartupcms-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>server</artifactId>
    <name>SmartupCMS Server</name>
    <description>Single-organization SmartupCMS modular monolith backend</description>

    <properties>
        <!-- Coverage floor of this module (plan 10/10, item 1.4): raised, never lowered, towards 0.80. -->
        <coverage.line.minimum>0.83</coverage.line.minimum>
        <coverage.branch.minimum>0.69</coverage.branch.minimum>
        <!-- Tests tagged "large" (plan 10/10, item 3.9: a 50 MB file applied in a 512 MB heap) run only with -Pupl-large,
             those tagged "audit-large" (item 3.5: the audit list on fifty million rows) only with -Paudit-large,
             those tagged "import-large" (item 5.8: an import of 10 000 rows in under 60 s) only with -Pimport-large. -->
        <test.groups></test.groups>
        <test.excludedGroups>large,audit-large,import-large</test.excludedGroups>
        <test.heap></test.heap>
    </properties>

    <dependencies>
        <!-- @NullMarked / @Nullable, checked by NullAway (plan 10/10, item 1.2); version from the Boot BOM. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Internal Platform Libraries -->
        <dependency>
            <groupId>com.smartup24.cms</groupId>
            <artifactId>core-types</artifactId>
        </dependency>
        <dependency>
            <groupId>com.smartup24.cms</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.smartup24.cms</groupId>
            <artifactId>provider-spi</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <!-- FR-NOTIF-3: доставка почты по SMTP. Без этого канал восстановления пароля мёртв -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <!-- Без этого /actuator/prometheus не существует, хотя и объявлен в exposure -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Database: PostgreSQL & Flyway -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Boot 4: автоконфигурация Flyway вынесена из autoconfigure в свой модуль -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Object storage: one S3-compatible contract for AWS, R2, MinIO and Garage. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- Security: Argon2 Hashing & Rate Limiting -->
        <dependency>
            <groupId>de.mkammerer</groupId>
            <artifactId>argon2-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The API description is generated from the controllers (plan 10/10, item 3.3); no Swagger UI. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Потоковое чтение xlsx при разборе загруженных файлов (модуль upl); Apache POI не используется. -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel-reader</artifactId>
            <version>0.20.2</version>
        </dependency>
        <!-- Запись xlsx: шаблоны анкет для поставщиков (upl) и синтетические файлы тестов; Apache POI не нужен. -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel</artifactId>
            <version>0.20.2</version>
        </dependency>
        <!-- Встроенный PostgreSQL для интеграционных тестов модулей DW:
             Docker в среде разработки недоступен, Testcontainers каркаса локально не поднимаются. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true ${test.heap}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                            <!-- build-info: версия приложения для локальной диагностики -->
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Acceptance of plan 10/10, item 3.9 (docs/ops/operations-runbook.md, "UPL apply"): only the tests tagged "large",
          in a JVM capped at 512 MB. Run with the test goal: mvn -pl apps/server test -Pupl-large
        -->
        <profile>
            <id>upl-large</id>
            <properties>
                <test.groups>large</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <test.heap>-Xmx512m</test.heap>
            </properties>
        </profile>
        <!--
          Acceptance of plan 10/10, item 3.5: the first page of the audit list on fifty million rows (fewer with
          -Daudit.large.rows=...). Run with the test goal: mvn -pl apps/server test -Paudit-large
        -->
        <profile>
            <id>audit-large</id>
            <properties>
                <test.groups>audit-large</test.groups>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
        <!--
          Acceptance of plan 10/10, item 5.8: an import of 10 000 rows through the entity runtime in under 60 s, with its
          error report (fewer or more with -Dimport.large.rows=...). Run with the test goal:
          mvn -pl apps/server test -Pimport-large
        -->
        <profile>
            <id>import-large</id>
            <properties>
                <test.groups>import-large</test.groups>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
        <!--
          Plan 10/10, item 6.5: `make dev` starts the server from the sources with Spring Boot DevTools, which restarts the
          context when a class is recompiled. Never active by default: the jar, the image and the tests stay without it.
          mvn -pl apps/server -Pdevtools spring-boot:run
        -->
        <profile>
            <id>devtools</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-devtools</artifactId>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
