{
  "name": "smartupcms-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=json-summary --coverage-reporters=text-summary",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "signals:audit": "node scripts/signal-order-audit.mjs",
    "i18n:audit": "node scripts/localization-audit.mjs",
    "contrast:audit": "node scripts/contrast-audit.mjs",
    "i18n:sync-ru": "node scripts/sync-packaged-russian.mjs",
    "aria:audit": "node scripts/aria-audit.mjs"
  },
  "engines": {
    "node": "24.15.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "bignumber.js": "^11.1.5",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  }
}
