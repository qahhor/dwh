{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright*.config.ts",
    "support/**/*.ts",
    "tests/browser/**/*.ts",
    "tests/security/**/*.ts"
  ]
}
