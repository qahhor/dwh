{
  "name": "smartupcms-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "test": "playwright test",
    "api:audit": "node scripts/api-deprecation-audit.mjs",
    "test:artifact-security": "node scripts/verify-artifact-security.mjs",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:instance": "playwright test --project=instance",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test -c playwright.a11y.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
