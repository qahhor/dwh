# Smartup-managed release acceptance: Hetzner compute + Cloudflare edge + R2.
# Copy outside the repository and replace every CHANGE_ME/blank value.
# This file is non-secret. Supply CLOUDFLARE_API_TOKEN, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY through the process environment or a secret manager.

ACCEPTANCE_PROFILE_ID=hetzner-cloudflare-r2-staging
ACCEPTANCE_TARGET_ENVIRONMENT=staging
ACCEPTANCE_PUBLIC_ORIGIN=https://CHANGE_ME_STAGING_HOST
ACCEPTANCE_ORIGIN_IP=CHANGE_ME
ACCEPTANCE_ORIGIN_DENIED_PORTS=80,5432,8080,8108,9090,3310,9100,9187
ACCEPTANCE_EXPECTED_SERVER_IMAGE=ghcr.io/OWNER/smartupcms/server@sha256:CHANGE_ME
ACCEPTANCE_EXPECTED_WEB_IMAGE=ghcr.io/OWNER/smartupcms/web@sha256:CHANGE_ME
ACCEPTANCE_EXPECTED_BACKUP_IMAGE=ghcr.io/OWNER/smartupcms/backup@sha256:CHANGE_ME
ACCEPTANCE_EXPECTED_POSTGRES_IMAGE=ghcr.io/OWNER/smartupcms/postgres@sha256:CHANGE_ME
ACCEPTANCE_EXPECTED_TYPESENSE_IMAGE=ghcr.io/OWNER/smartupcms/typesense@sha256:CHANGE_ME
ACCEPTANCE_EXPECTED_CLAMAV_IMAGE=ghcr.io/OWNER/smartupcms/clamav@sha256:CHANGE_ME
ACCEPTANCE_HOST_PROFILE=hetzner-ccx33-8cpu-32gb-nbg1

ACCEPTANCE_CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
ACCEPTANCE_CLOUDFLARE_ZONE_ID=CHANGE_ME
ACCEPTANCE_CLOUDFLARE_ZONE_NAME=CHANGE_ME

# The application bucket must stay private: r2.dev disabled, no enabled custom
# domains, and no browser CORS rules. Browser traffic goes through SmartupCMS.
ACCEPTANCE_R2_BUCKET=CHANGE_ME
ACCEPTANCE_R2_RECOVERY_BUCKET=CHANGE_ME
ACCEPTANCE_R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
ACCEPTANCE_R2_LIFECYCLE_RULE_ID=abort-incomplete-multipart
ACCEPTANCE_R2_TEST_PREFIX=acceptance

# These URLs must be access-controlled monitoring endpoints. The test endpoint
# is called with POST and must deliver a labelled drill event to the on-call.
ACCEPTANCE_SCANNER_HEALTH_URL=https://CHANGE_ME_MONITORING_HOST/probes/clamav
ACCEPTANCE_ALERT_HEALTHCHECK_URL=https://CHANGE_ME_MONITORING_HOST/health
ACCEPTANCE_ALERT_TEST_URL=https://CHANGE_ME_MONITORING_HOST/drill

# API latency thresholds approved by the product owner on 2026-10-10
# (NFR-PERF-02: p95 <= 300 ms, p99 <= 1 s). The other installation
# thresholds below are approved in docs/ops/staging-acceptance.md; the
# release owner still supplies target identities and access.
ACCEPTANCE_MAX_P95_MS=300
ACCEPTANCE_MAX_P99_MS=1000
# NFR-PERF-02: file upload transfer latency approved on 2026-10-12.
ACCEPTANCE_MAX_UPLOAD_P95_MS=30000
ACCEPTANCE_MAX_UPLOAD_P99_MS=60000
ACCEPTANCE_MAX_ERROR_RATE=0.001
ACCEPTANCE_MAX_HIKARI_PENDING=0
ACCEPTANCE_MAX_HEAP_PERCENT=80
ACCEPTANCE_MIN_FREE_DISK_GIB=50
ACCEPTANCE_MAX_TEMP_GROWTH_MIB=128
ACCEPTANCE_MAX_SCANNER_P95_MS=5000
ACCEPTANCE_MAX_R2_P95_MS=10000
ACCEPTANCE_MAX_ORPHAN_OBJECTS=0

# Load tests are staging-only and intentionally create tasks and file metadata.
ACCEPTANCE_LOAD_WRITES=true
ACCEPTANCE_INTERACTIVE_DURATION=15m
