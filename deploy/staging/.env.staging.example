# Merge these values with deploy/compose/.env.example in a private 0600 file.
# Blank values are intentional blockers. Never run with invented digests or secrets.
PROJECT_NAME=smartupcms-staging
APP_VERSION=
SERVER_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=
POSTGRES_IMAGE=
TYPESENSE_IMAGE=
CLAMAV_IMAGE=
ORGANIZATION_CODE=staging
ORGANIZATION_NAME=SmartupCMS staging
SMC_PUBLIC_URL=
SMC_PROVIDER_STORAGE=s3
SMC_S3_ENDPOINT=
SMC_S3_BUCKET=
SMC_S3_REGION=auto
SMC_S3_PATH_STYLE=true
SMC_S3_ACCESS_KEY=
SMC_S3_SECRET_KEY=
SMC_PROVIDER_MAIL=smtp
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMC_MAIL_FROM=
SMC_BACKUP_MAX_AGE=20h
BACKUP_STORAGE_MODE=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_INTERVAL_SECONDS=43200
# Remote recovery retention is 14 days locked / lifecycle expiry after 15 days.
# Local cache pruning is a separate staging gate, not implemented by this day-based setting.
BACKUP_RETENTION_DAYS=14
MONITOR_DB_PASSWORD_FILE=
STAGING_CLAMAV_SCRATCH_PATH=
STAGING_PROMETHEUS_CONFIG=
STAGING_MONITORING_TLS_DIR=
