global:
  resolve_timeout: 5m
route:
  receiver: oncall
  group_by: [alertname, installation]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 30m
receivers:
  - name: oncall
    webhook_configs:
      - url_file: /run/secrets/alert_webhook_url
        send_resolved: true
        timeout: 10s
