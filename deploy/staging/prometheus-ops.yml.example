# Receive the app collector over the private host TLS edge. One staging installation only.
# Add docker-compose.alerting.yml and test the private receiver before launch.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - /etc/prometheus/rules/recording.yml
  - /etc/prometheus/rules/alerts.yml
  - /etc/prometheus/rules/infrastructure.yml
  - /etc/prometheus/rules/operations.yml
scrape_configs:
  - job_name: smartupcms-recovery
    static_configs:
      - targets: [recovery-metrics:9100]
        labels: {installation: smartupcms-staging}
  - job_name: smartupcms-alertmanager
    static_configs:
      - targets: [alertmanager:9093]
  - job_name: smartupcms-external
    metrics_path: /probe
    params: {module: [https_api]}
    static_configs:
      - targets: [https://CHANGE_ME_PUBLIC_HOST/api/v1/i18n/ru]
        labels: {installation: smartupcms-staging}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
alerting:
  alertmanagers:
    - scheme: http
      static_configs:
        - targets: [alertmanager:9093]
