# Шаблон окружения экземпляра. Скопировать в .env и заполнить.
# .env НИКОГДА не коммитится (см. .gitignore). Целевое хранилище секретов —
# Vault (фаза P); до него — файл с правами 600, владелец — пользователь деплоя.

# --- имя проекта (группа в Docker) -----------------------------------------
PROJECT_NAME=SmartupCMS

# --- идентификация клиента (FR-INST-1) -------------------------------------
CLIENT_CODE=client-042
CLIENT_NAME=ООО Клиент
RESOURCE_PROFILE=S                  # S | M | L (ТЗ-01 разд. 5.1)

# --- версия образа ---------------------------------------------------------
IMAGE_REGISTRY=smartupcms
APP_VERSION=                        # ОБЯЗАТЕЛЬНО: конкретный тег, никогда не latest

# --- база данных -----------------------------------------------------------
DB_NAME=dwh_instance
DB_USER=dwh
DB_PASSWORD=                        # сгенерировать: openssl rand -base64 24

# --- первый администратор (создаётся один раз при первом старте) -----------
DWH_INSTANCE_ADMIN_LOGIN=admin
DWH_INSTANCE_ADMIN_EMAIL=
DWH_INSTANCE_ADMIN_PASSWORD=        # сгенерировать; смена обязательна при первом входе

# --- сеть ------------------------------------------------------------------
APP_BIND=127.0.0.1                  # публикуем только на loopback: наружу — через reverse proxy с TLS
APP_PORT=8080

# --- ресурсы (согласовать с профилем, ТЗ-01 разд. 5.1) ---------------------
APP_CPUS=2
APP_MEMORY=2g
PG_CPUS=2
PG_MEMORY=4g

# --- бэкапы ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
