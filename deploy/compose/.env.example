# Шаблон окружения экземпляра. Скопировать в .env и заполнить.
# .env НИКОГДА не коммитится (см. .gitignore). Целевое хранилище секретов —
# Vault (фаза P); до него — файл с правами 600, владелец — пользователь деплоя.

# --- имя проекта (группа в Docker) -----------------------------------------
PROJECT_NAME=SmartupCMS

# --- идентификация клиента (FR-INST-1) -------------------------------------
CLIENT_CODE=client-042
CLIENT_NAME=ООО Клиент
RESOURCE_PROFILE=S                  # S | M | L (ТЗ-01 разд. 5.1)

# --- версия образа ---------------------------------------------------------
IMAGE_REGISTRY=smartupcms
POSTGRES_IMAGE=smartupcms/postgres:18-alpine-hardened
APP_VERSION=                        # ОБЯЗАТЕЛЬНО: конкретный тег, никогда не latest

# --- база данных -----------------------------------------------------------
DB_NAME=dwh_instance
DB_USER=dwh
DB_PASSWORD=                        # сгенерировать: openssl rand -base64 24

# --- первый администратор (создаётся один раз при первом старте) -----------
DWH_INSTANCE_ADMIN_LOGIN=admin
DWH_INSTANCE_ADMIN_EMAIL=
DWH_INSTANCE_ADMIN_PASSWORD=        # сгенерировать; смена обязательна при первом входе

# --- связь с control plane (FR-INST-3) -------------------------------------
# Токен выдаётся один раз при регистрации экземпляра в панели управления
# (вкладка «Клиенты» -> «Регистрация экземпляра»). Пусто — экземпляр не будет
# виден в реестре флота, на его работу это не влияет.
DWH_CP_URL=                         # например https://cp.smartup.uz
DWH_CP_HEARTBEAT_TOKEN=
DWH_CP_HEARTBEAT_INTERVAL=5m        # ТЗ допускает 1–5 мин

# --- сеть ------------------------------------------------------------------
APP_BIND=127.0.0.1                  # публикуем только на loopback: наружу — через reverse proxy с TLS
APP_PORT=8080

# Fleet compose публикует собственный HTTP proxy только на loopback. TLS
# обязан завершаться на host reverse proxy и пересылать трафик на этот порт.
PROXY_BIND=127.0.0.1
HTTP_PORT=8088

# --- control plane (требуется для docker-compose.fleet.prod.yml) -----------
CP_DB_NAME=dwh_control_plane
CP_DB_USER=dwh_cp
CP_DB_PASSWORD=                     # отдельный пароль: openssl rand -base64 24
CP_ADMIN_LOGIN=cpadmin
CP_ADMIN_PASSWORD=                  # отдельный пароль администратора панели

# --- Typesense (требуется для docker-compose.fleet.prod.yml) ---------------
TYPESENSE_API_KEY=                  # openssl rand -base64 32

# --- ресурсы (согласовать с профилем, ТЗ-01 разд. 5.1) ---------------------
APP_CPUS=2
APP_MEMORY=2g
PG_CPUS=2
PG_MEMORY=4g

# --- бэкапы ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_UID=1000                     # UID пользователя деплоя, владеющего каталогом backups
BACKUP_GID=1000
