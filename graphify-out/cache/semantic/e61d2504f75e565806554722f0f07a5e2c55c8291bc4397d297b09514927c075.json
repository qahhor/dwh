{"nodes": [{"id": "docs_ops_maintenance_guide_maintenance_guide", "label": "\u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044e \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u0430", "file_type": "document", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ops_maintenance_guide_upgrade_procedure", "label": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0435\u0440\u0441\u0438\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f", "file_type": "concept", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043d\u0430\u0440\u0443\u0448\u0430\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f: \u0441\u0432\u0435\u0436\u0438\u0439 \u0431\u044d\u043a\u0430\u043f \u0434\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f, \u043e\u0431\u0440\u0430\u0437 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0440\u0430\u043d\u0435\u0435 (\u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u0435), \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u0448\u0430\u0433\u043e\u043c, \u043f\u0440\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u0445 \u2014 \u043e\u0442\u043a\u0430\u0442, \u0430 \u043d\u0435 \u043f\u043e\u0447\u0438\u043d\u043a\u0430 \u043d\u0430 \u0436\u0438\u0432\u043e\u043c. \u041f\u0440\u0430\u0432\u0438\u043b\u043e \u043f\u0438\u043b\u043e\u0442\u0430: \u0441\u0442\u0435\u043d\u0434 \u2192 1\u20132 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u2192 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u043b\u0435\u0446."}, {"id": "docs_ops_maintenance_guide_dependency_patching", "label": "\u041f\u0430\u0442\u0447\u0438\u043d\u0433 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0435\u0439 \u0438 \u0431\u0430\u0437\u043e\u0432\u044b\u0445 \u043e\u0431\u0440\u0430\u0437\u043e\u0432", "file_type": "concept", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ops_maintenance_guide_backup_policy", "label": "\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0431\u044d\u043a\u0430\u043f\u043e\u0432 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u043a\u043e\u043d\u0442\u0443\u0440\u0430 (pg_dump, retention)", "file_type": "concept", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041d\u0435\u0442 WAL-\u0430\u0440\u0445\u0438\u0432\u0430 (\u0442\u043e\u0447\u043a\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u2014 \u043c\u043e\u043c\u0435\u043d\u0442 \u0434\u0430\u043c\u043f\u0430, \u0434\u043e \u0441\u0443\u0442\u043e\u043a \u043f\u043e\u0442\u0435\u0440\u044c \u0432\u043c\u0435\u0441\u0442\u043e 15 \u043c\u0438\u043d\u0443\u0442 NFR-7), \u043d\u0435\u0442 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f (\u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0441 \u0434\u0430\u043d\u043d\u044b\u043c\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u0432\u0438\u0434\u0435), \u043d\u0435\u0442 \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438."}, {"id": "docs_ops_maintenance_guide_restore_verification", "label": "\u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u0437 \u0431\u044d\u043a\u0430\u043f\u0430", "file_type": "rationale", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041d\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0431\u044d\u043a\u0430\u043f \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u2014 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u043e\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0435 \u0441\u043e smoke-\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u043c\u0438 (\u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439/\u0437\u0430\u0434\u0430\u0447 \u0438 \u0432\u0435\u0440\u0441\u0438\u044f \u0441\u0445\u0435\u043c\u044b) \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0442\u0447\u0451\u0442 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438."}, {"id": "docs_ops_maintenance_guide_secret_rotation", "label": "\u0420\u043e\u0442\u0430\u0446\u0438\u044f \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0432 \u043f\u043e \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044e \u0438 \u043f\u043e \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442\u0443", "file_type": "concept", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u043c\u0435\u043d\u044b \u043f\u0430\u0440\u043e\u043b\u044f \u0411\u0414 \u0441\u0442\u0440\u043e\u0433\u0438\u0439: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0411\u0414, \u043f\u043e\u0442\u043e\u043c .env \u2014 \u0438\u043d\u0430\u0447\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0441\u044f. \u041e\u0442\u0437\u044b\u0432 API-\u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0438 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430."}, {"id": "docs_ops_maintenance_guide_audit_partition_maintenance", "label": "\u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u0440\u0442\u0438\u0446\u0438\u0439 audit_log", "file_type": "concept", "source_file": "docs/ops/maintenance-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0430\u0440\u0442\u0438\u0446\u0438\u0438 \u0437\u0430\u0434\u0430\u043d\u044b \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0435\u0439 \u043d\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u043c\u0435\u0441\u044f\u0446\u044b: \u043f\u0440\u0438 \u0438\u0445 \u0438\u0441\u0447\u0435\u0440\u043f\u0430\u043d\u0438\u0438 \u0437\u0430\u043f\u0438\u0441\u0438 \u0443\u0445\u043e\u0434\u044f\u0442 \u0432 audit_log_default, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u043f\u0430\u0440\u0442\u0438\u0446\u0438\u0439 \u043d\u0430 2 \u043c