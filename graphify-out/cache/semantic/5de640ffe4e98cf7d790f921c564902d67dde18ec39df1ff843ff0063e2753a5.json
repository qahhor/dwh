{"nodes": [{"id": "docs_trd_trd_03_flows_trd_03", "label": "\u0422\u0417-03: \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438 (flows) \u042d\u0442\u0430\u043f\u0430 1", "file_type": "document", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_trd_03_flows_flow_as_acceptance_source", "label": "\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u2014 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438\u0441\u0442\u0438\u043d\u044b \u0434\u043b\u044f \u043f\u0440\u0438\u0451\u043c\u043a\u0438 \u0432\u0435\u0445\u0438", "file_type": "rationale", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0420\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043e \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0435\u043c \u2014 \u0434\u0435\u0444\u0435\u043a\u0442, \u0430 \u043d\u0435 \u00ab\u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u044f\u00bb: \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0441 \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u044b\u043c\u0438 \u0432\u0435\u0442\u043a\u0430\u043c\u0438 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0434\u043e \u043a\u043e\u0434\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u0451\u043c\u043a\u0430 \u043d\u0435 \u0441\u0432\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043a \u0441\u043f\u043e\u0440\u0443 \u043e \u0442\u0440\u0430\u043a\u0442\u043e\u0432\u043a\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f."}, {"id": "docs_trd_trd_03_flows_f01_login_2fa", "label": "F-01. \u0412\u0445\u043e\u0434 \u0441 2FA (OTP \u0447\u0435\u0440\u0435\u0437 Telegram)", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u043d\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438 \u043b\u043e\u0433\u0438\u043d; \u0441\u0442\u0430\u0442\u0443\u0441 \u00ab\u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u00bb \u043e\u0442\u0434\u0430\u0451\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043f\u0430\u0440\u043e\u043b\u044f; \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0432\u0445\u043e\u0434\u0430 \u043d\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0443\u0447\u0451\u0442\u043a\u0443 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u2014 \u0437\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 DoS \u043d\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f."}, {"id": "docs_trd_trd_03_flows_f02_telegram_binding", "label": "F-02. \u041f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 Telegram-\u043a\u0430\u043d\u0430\u043b\u0430 deep-link'\u043e\u043c", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041e\u0442\u0432\u044f\u0437\u043a\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0430 2FA \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u0430 (409 last_2fa_channel), chat_id \u043d\u0435 \u0432\u0438\u0434\u0435\u043d \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c."}, {"id": "docs_trd_trd_03_flows_f03_employee_onboarding", "label": "F-03. \u041e\u043d\u0431\u043e\u0440\u0434\u0438\u043d\u0433 \u043d\u043e\u0432\u043e\u0433\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041e\u0442 \u00ab\u0421\u043e\u0437\u0434\u0430\u0442\u044c\u00bb \u0434\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u2014 \u0431\u0435\u0437 \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u043d\u0430\u0448\u0435\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438: \u044d\u0442\u043e \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0441\u0430\u043c\u043e\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0430\u0434\u043c\u0438\u043d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430."}, {"id": "docs_trd_trd_03_flows_f04_access_management", "label": "F-04. \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c: \u0432\u044b\u0434\u0430\u0442\u044c, \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u043e\u0442\u043e\u0437\u0432\u0430\u0442\u044c", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041c\u0430\u0441\u0441\u043e\u0432\u044b\u0439 \u043f\u0435\u0440\u0435\u0441\u0447\u0451\u0442 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 202 \u0441 operation_id \u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u043e\u043c, \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0432\u0430 \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u043b\u0435\u0442\u0443; \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u0440\u043e\u043b\u044c \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u044f\u0435\u043c\u0430, \u0441\u043d\u044f\u0442\u0438\u0435 \u0440\u043e\u043b\u0438 \u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0430\u0434\u043c\u0438\u043d\u0430 \u043e\u0442\u043a\u043b\u043e\u043d\u044f\u0435\u0442\u0441\u044f."}, {"id": "docs_trd_trd_03_flows_f05_task_lifecycle", "label": "F-05. \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0446\u0438\u043a\u043b \u0437\u0430\u0434\u0430\u0447\u0438", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0418\u043d\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u0430 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u044b\u0435 \u0432\u0435\u0442\u043a\u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044f: \u0440\u043e\u0432\u043d\u043e \u043e\u0434\u0438\u043d \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439, \u043d\u0435\u0438\u0437\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0439 \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a, \u0437\u0430\u043f\u0440\u0435\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c\u0438 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438."}, {"id": "docs_trd_trd_03_flows_f06_platform_announcement", "label": "F-06. \u041e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u2192 \u0432\u0441\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u044b", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0438\u0434\u0435\u043c\u043f\u043e\u0442\u0435\u043d\u0442\u043d\u044b \u043f\u043e id, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u0444\u043b\u0430\u0439\u043d-\u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0442\u0435\u0440\u044f\u0435\u0442 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442 \u0438\u0445 \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u043e\u043c \u0436\u0435 pull; \u043e\u0442\u043c\u0435\u0442\u043a\u0430 \u043f\u0440\u043e\u0447\u0442\u0435\u043d\u0438\u044f \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u0430\u044f \u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0443 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438."}, {"id": "docs_trd_trd_03_flows_f07_permission_change_investigation", "label": "F-07. \u0420\u0430\u0437\u0431\u043e\u0440 \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442\u0430 \u00ab\u043a\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u043f\u0440\u0430\u0432\u0430 X?\u00bb", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435, \u0441\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0435 API-\u0442\u043e\u043a\u0435\u043d\u043e\u043c, \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u043c\u043e \u0432 \u0430\u0443\u0434\u0438\u0442\u0435 (\u00ab\u0447\u0435\u0440\u0435\u0437 API, \u0442\u043e\u043a\u0435\u043d \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f-1\u0421\u00bb) \u2014 \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u043c."}, {"id": "docs_trd_trd_03_flows_f08_employee_offboarding", "label": "F-08. \u0411\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u043f\u0440\u0438 \u0443\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u0438\u0438", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u0430\u043c\u044b\u0439 \u0447\u0430\u0441\u0442\u044b\u0439 \u00ab\u043a\u0440\u0438\u0442\u0438\u0447\u043d\u044b\u0439\u00bb \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 B2B: \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u00ab\u0445\u0432\u043e\u0441\u0442\u044b\u00bb \u2014 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0443\u0432\u043e\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0441 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f; \u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0435 \u0443\u0434\u0430\u043b\u044f\u044e\u0442\u0441\u044f, \u043f\u043e\u043b\u043d\u043e\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 = \u0430\u043d\u043e\u043d\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u0441 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u043e\u043c."}, {"id": "docs_trd_trd_03_flows_f09_fleet_duty_morning", "label": "F-09. \u0423\u0442\u0440\u043e \u0434\u0435\u0436\u0443\u0440\u043d\u043e\u0433\u043e \u043f\u043e \u0444\u043b\u043e\u0442\u0443", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u0440\u043e\u0432\u0430\u043b \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0431\u044d\u043a\u0430\u043f\u0430 \u043f\u0440\u0438 \u0436\u0438\u0432\u043e\u043c heartbeat \u2014 \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b, \u0430 \u043d\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0430; \u043e\u0442 \u0430\u043b\u0435\u0440\u0442\u0430 \u0434\u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0437\u0430 \u2264 10 \u043c\u0438\u043d \u0431\u0435\u0437 SSH, \u043a\u0430\u0436\u0434\u044b\u0439 \u0448\u0430\u0433 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043b\u0435\u0434."}, {"id": "docs_trd_trd_03_flows_f10_password_recovery", "label": "F-10. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0437\u0430\u0431\u044b\u0442\u043e\u0433\u043e \u043f\u0430\u0440\u043e\u043b\u044f", "file_type": "concept", "source_file": "docs/trd/TRD-03-flows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0417\u0430\u043f\u0440\u043e\u0441 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 204, \u043d\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044f \u043d\u0430\u043b\u0438\u0447\u0438\u0435 email \u0432 \u0431\u0430\u0437\u0435; \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043f\u0430\u0440\u043e\u043b\u044f \u0432\u0441\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0441\u0435\u0441\u0441\u0438\u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0432 \u0442\u043e\u0439 \u0436\u0435 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0435\u0442\u0430\u0446\u0438\