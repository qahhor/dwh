{"nodes": [{"id": "docs_plan_module_review_plan_module_review_plan", "label": "\u041f\u043b\u0430\u043d \u043f\u043e\u043c\u043e\u0434\u0443\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 CMS (\u042d\u0442\u0430\u043f 1)", "file_type": "document", "source_file": "docs/plan/module-review-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041c\u0435\u0436\u0434\u0443 \u00ab\u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u043e \u0432 \u0422\u0417\u00bb, \u00ab\u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u0432 \u0411\u0414\u00bb, \u00ab\u0435\u0441\u0442\u044c \u043a\u043b\u0430\u0441\u0441 \u0432 \u043a\u043e\u0434\u0435\u00bb \u0438 \u00ab\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e\u00bb \u2014 \u0440\u0430\u0437\u043d\u044b\u0435 \u0432\u0435\u0449\u0438; \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442 \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u043f\u043e \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u043c\u043e\u0434\u0443\u043b\u044e. \u041c\u043e\u0434\u0443\u043b\u044c \u0437\u0430\u043a\u0440\u044b\u0442, \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u044b \u0432\u0441\u0435 \u0435\u0433\u043e M-\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0436\u0438\u0432\u043e\u043c \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u0435."}, {"id": "docs_plan_module_review_plan_six_step_protocol", "label": "\u041f\u0440\u043e\u0442\u043e\u043a\u043e\u043b \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430 \u043c\u043e\u0434\u0443\u043b\u044f (6 \u0448\u0430\u0433\u043e\u0432)", "file_type": "rationale", "source_file": "docs/plan/module-review-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430 \u2192 \u043b\u043e\u0433\u0438\u043a\u0430 \u2192 \u043f\u043e\u043b\u044f \u0411\u0414 \u2192 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u2192 \u043f\u0440\u0430\u0432\u0430 \u0438 \u0430\u0443\u0434\u0438\u0442 \u2192 \u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u041f\u0440\u043e\u043f\u0443\u0441\u043a \u0448\u0430\u0433\u0430 \u2014 \u043d\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u044f, \u0430 \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0434\u0435\u0444\u0435\u043a\u0442\u0430 \u043d\u0430 \u043f\u043e\u0442\u043e\u043c."}, {"id": "docs_plan_module_review_plan_review_order_circles", "label": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0430: \u043a\u0440\u0443\u0433\u0438 1\u20134", "file_type": "rationale", "source_file": "docs/plan/module-review-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044f\u043c, \u0430 \u043d\u0435 \u043f\u043e \u043d\u043e\u043c\u0435\u0440\u0430\u043c \u0422\u0417: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u044f\u0434\u0440\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0430 (\u0431\u0435\u0437 \u043d\u0435\u0433\u043e \u0432\u0441\u0451 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0437\u044b\u0431\u043a\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438), \u0437\u0430\u0442\u0435\u043c \u0441\u043a\u0432\u043e\u0437\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0440\u0430\