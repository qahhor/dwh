<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent gives the build its plugins only (formatting, Checkstyle, Error Prone, coverage); the module itself
         depends on nothing of the platform but its API and, in tests, its test kit (ADR-0033, 8). -->
    <parent>
        <groupId>com.smartup24.cms</groupId>
        <artifactId>smartupcms-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.acme.cms</groupId>
    <artifactId>library-module</artifactId>
    <!-- The version of the jar follows the reactor (the parent's dependency management versions the platform's own
         libraries by it); the module's own version, 1.2.0, is the one its manifest states. -->
    <name>Example module outside the monorepo: library</name>
    <description>A SmartupCMS module built against the platform API alone and checked by the platform test kit
        (ADR-0033, 8)</description>

    <properties>
        <!-- Coverage floor of this module (plan 10/10, item 1.4): raised, never lowered, towards 0.80. -->
        <coverage.line.minimum>0.97</coverage.line.minimum>
        <coverage.branch.minimum>0.66</coverage.branch.minimum>
    </properties>

    <dependencies>
        <!-- The contract the module builds against; the platform brings it at run time. -->
        <dependency>
            <groupId>com.smartup24.cms</groupId>
            <artifactId>platform-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @Configuration and @Bean of the configuration the manifest names; the platform brings Spring at run time. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.smartup24.cms</groupId>
            <artifactId>platform-testkit</artifactId>
            <!-- The kit of the platform this example is built with; a module outside the monorepo names its platform. -->
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
