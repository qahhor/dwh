{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "backend (mvn verify + ArchUnit + SBOM)", "integration_id": 15368 },
          { "context": "frontend (unit + typecheck + build)", "integration_id": 15368 },
          { "context": "api contract (Spectral + openapi-diff + web types)", "integration_id": 15368 },
          { "context": "cms CLI (node:test, ubuntu-24.04)", "integration_id": 15368 },
          { "context": "cms CLI (node:test, windows-2025)", "integration_id": 15368 },
          { "context": "release config (Compose + NGINX + fail-closed deploy)", "integration_id": 15368 },
          { "context": "observability (promtool rules + unit tests, dashboards)", "integration_id": 15368 },
          { "context": "e2e (clean deploy + Playwright Chromium, shard 1/2)", "integration_id": 15368 },
          { "context": "e2e (clean deploy + Playwright Chromium, shard 2/2)", "integration_id": 15368 },
          { "context": "security (gitleaks + trivy)", "integration_id": 15368 },
          { "context": "Verify commit sign-offs", "integration_id": 15368 },
          { "context": "codeql (java-kotlin)", "integration_id": 15368 },
          { "context": "codeql (javascript-typescript)", "integration_id": 15368 },
          { "context": "codeql (actions)", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          { "tool": "CodeQL", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" }
        ]
      }
    }
  ]
}
