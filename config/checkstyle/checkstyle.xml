<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Java rules of SmartupCMS (plan 10/10, item 1.2). Layout belongs to Spotless (palantir-java-format);
  these rules catch what a formatter does not: naming, imports, and constructs that hide a defect.
  Local waivers: // CHECKSTYLE.OFF: RuleName ... // CHECKSTYLE.ON: RuleName, with the reason on the line above.
  NeedBraces is left out on purpose: the defect it prevents is indentation that lies about the body of an
  if, and the formatter re-indents every line, so a second statement can no longer look guarded.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="SuppressWithPlainTextCommentFilter">
        <property name="offCommentFormat" value="CHECKSTYLE.OFF\: ([\w\|]+)"/>
        <property name="onCommentFormat" value="CHECKSTYLE.ON\: ([\w\|]+)"/>
        <property name="checkFormat" value="$1"/>
    </module>

    <!-- Tests keep mutable fixtures in static final fields (a sequence, a container); they are not constants. -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
        <property name="checks" value="ConstantName"/>
    </module>

    <!-- Size limits (plan 10/10, item 3.10) hold for main code only: a test class groups the cases of one unit,
         and a long test method is a scenario read top to bottom. -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
        <property name="checks" value="FileLength|MethodLength"/>
    </module>
    <!-- Tests build their own mappers and catch the failures they expect (item 3.11 holds for main code). -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
        <property name="id" value="noEmptyCatch"/>
    </module>
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
        <property name="id" value="singleObjectMapper"/>
    </module>
    <!-- Temporary waiver: UplXlsxParser streams rows since item 3.9; splitting its reading from its checks is the
         next step. -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]upl[\\/]parse[\\/]UplXlsxParser\.java$"/>
        <property name="checks" value="FileLength|MethodLength"/>
    </module>

    <!-- A class over 400 lines holds more than one responsibility; split it rather than raise the limit. -->
    <module name="FileLength">
        <property name="max" value="400"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">
        <!-- A method over 60 lines mixes levels of abstraction; extract the steps. -->
        <module name="MethodLength">
            <property name="max" value="60"/>
            <property name="countEmpty" value="false"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF"/>
        </module>

        <!-- Naming -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <!-- Tests name the case: directConnection_ignoresSpoofedXff. -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <!-- The logger is `log`, as in the rest of the code base. -->
        <module name="ConstantName">
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="StaticVariableName"/>
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>

        <!-- Imports -->
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, com.sun.proxy, jdk.internal"/>
        </module>

        <!-- Constructs that hide a defect -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyStatement"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <!-- Plan 10/10, item 3.11: no error is swallowed. A catch in main code is never empty, whatever its variable
             or comment says (NoSwallowedErrorsTest checks that it rethrows, logs or uses what it caught). -->
        <module name="EmptyCatchBlock">
            <property name="id" value="noEmptyCatch"/>
            <property name="exceptionVariableName" value="^$"/>
            <property name="commentFormat" value="(?!)"/>
        </module>
        <module name="FallThrough"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="CovariantEquals"/>
        <module name="SuperClone"/>
        <module name="NoFinalizer"/>
        <module name="OneStatementPerLine"/>
        <module name="ModifiedControlVariable"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>

        <!-- Plan 10/10, item 3.11: one ObjectMapper, the application's (or JsonMapper.shared() outside Spring), and JSON
             columns through JsonColumns, not a private copy of toJson/parseJson. -->
        <module name="Regexp">
            <property name="id" value="singleObjectMapper"/>
            <property name="format" value="new ObjectMapper\(|private [\w&lt;&gt;, ?]+ (toJson|parseJson|readJson)\("/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use the injected ObjectMapper and JsonColumns (plan 10/10, item 3.11)."/>
        </module>

        <!-- The log carries diagnostics; a stray print or stack trace bypasses the PII masking of logback. -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print|\.printStackTrace\(\)"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use the logger: System.out/err and printStackTrace bypass the log pipeline."/>
        </module>
    </module>
</module>
